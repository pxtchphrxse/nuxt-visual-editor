{
  "name": "nuxt-visual-editor",
  "version": "2.0.0-rc.0",
  "description": "Visual (layout) editor for Nuxt",
  "license": "MIT",
  "repository": "pxtchphrxse/nuxt-visual-editor",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./library": {
      "types": "./dist/app/library.d.ts",
      "import": "./dist/app/library.js"
    }
  },
  "scripts": {
    "build": "node build/build.ts",
    "prepack": "pnpm build",
    "dev": "node build/build.ts && nuxi dev playground",
    "dev:prepare": "node build/build.ts && nuxi prepare playground",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project smoke",
    "audit:deps": "pnpm audit && node scripts/check-deprecated.ts",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "prepare": "husky",
    "test:fixtures:nuxt3": "pnpm --dir test/fixtures/nuxt3 install",
    "previews": "node scripts/generate-previews.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^3.21.0 || ^4.0.0",
    "dompurify": "^3.4.15",
    "jsdom": "^30.1.1",
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/schema": "^4.5.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "changelogen": "^0.6.2",
    "cssnano": "^9.0.5",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "monocart-coverage-reports": "^2.13.0",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-preset-env": "^11.5.3",
    "sass": "^1.105.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
